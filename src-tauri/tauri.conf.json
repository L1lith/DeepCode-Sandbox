{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepsand",
  "version": "0.1.0",
  "identifier": "dev.deepsand.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deepsand",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Run DeepCode inside a container it cannot escape",
    "longDescription": "Deepsand runs the DeepCode coding agent inside a Docker container that can only see the project directory and whatever you explicitly share with it. DeepCode can ask for more access through a permission dialog; you decide, and the sandbox is recreated to apply it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime": "runtime",
      "../dist": "ui"
    },
    "linux": {
      "deb": {
        "depends": ["docker.io"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0QTUyNDI4Qjk1NDJFMjkKUldRcExsUzVLQ1NseERKTGg3ckVmZjNSYkNQODcyTWRlYVdHVXhjVytkelJvZ3cveGoyRnB3eDQK",
      "endpoints": [
        "https://github.com/L1lith/Deepsand/releases/latest/download/latest.json"
      ]
    }
  }
}
